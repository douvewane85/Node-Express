
 {
    "openapi": "3.0.0",
    "info": {
    "title": "Comptes API",
    "version": "1.0.0",
    "description": "API simple pour gérer les comptes et les transactions."
    },
    "servers": [
        {
        "url": "http://localhost:3002",
        "description": "Local server"
        },
        {
           "url": "https://www.iibs.com",
           "description": "Production server"  
        }
   ],
   "paths": {
      "/api/v1/comptes": {
           "get": {
             "summary": "Récupère la liste des compte (avec filtrage et pagination)",
             "parameters": [
                {
                    "name": "type",
                    "in": "query",
                    "description": "Filtrer par type (ex: Epargne ou cheque)",
                    "required": false,
                    "schema": { 
                        "type": "string",
                        "enum": ["Epargne", "Cheque"] 
                    }  },
                {
                "name": "page",
                "in": "query",
                "description": "Numéro de page (1-based)",
                "required": false,
                "schema": { "type": "integer", "default": 1 }
                },
                {
                "name": "size",
                "in": "query",
                "description": "Taille de page",
                "required": false,
                "schema": { "type": "integer", "default": 10 }
                }
            ],
             "responses": {
            "200": {
            "description": "Liste des comptes récupérée avec succès",
            "content": {
                "application/json": {
                "schema": {
                    "$ref": "#/components/schemas/CompteListResponse"   
                }
            }
        }
        }
        }
             



           },
           "post": {
             "summary": "Créer un nouveau compte",
             "requestBody": {
               "required": true,
               "content": {
                 "application/json": {
                   "schema": { "$ref": "#/components/schemas/CompteCreateRequest" }
                 }
               }
             },
             "responses": {
               "201": {
                 "description": "Compte créé avec succès",
                 "content": {
                   "application/json": {
                     "schema": { "$ref": "#/components/schemas/CompteAll" }
                   }
                 }
               }
             }
           }
      },
       "/api/v1/comptes/{numero}/solde": {
            "get": {
              "summary": "Récupère le solde d'un compte",
              "parameters": [
                {
                  "name": "numero",
                  "in": "path",
                  "description": "Numéro du compte",
                  "required": true,
                  "schema": { "type": "string" }
                }
              ],
              "responses": {
                "200": {
                  "description": "Solde du compte récupéré avec succès",
                  "content": {
                    "application/json": {
                      "schema": { "$ref": "#/components/schemas/CompteSoldeResponse" }
                    }
                  }
                }
              }
            }  
      }
   },
    "components": {
   "schemas": {
     "CompteAll": {
       "type": "object",
       "properties": {
         "id": { "type": "integer" },
         "numero": { "type": "string" },
         "type": { 
            "type": "string",
            "enum": ["Epargne", "cheque"] 
         } ,
         "titulaire": { "type": "string" },
         "solde": { "type": "number" },
         "createAt":{"type": "string", "format": "date" }
       }
     },
      "CompteSolde": {
       "type": "object",
       "properties": {
         "id": { "type": "integer" },
         "numero": { "type": "string" },
         "titulaire": { "type": "string" },
         "solde": { "type": "number" }

       }
     }
     ,
    "CompteSoldeResponse" :{
      "type": "object",
       "properties": {
         "statut": { "type": "boolean" },
         "statutCode": { "type": "integer" },
           "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/CompteSolde" }
       },
      "required": ["statutCode","statut", "data", "message"]  
    },
   "CompteListResponse": {
        "type": "object",
        "properties": {
            "statut": { "type": "boolean" },
            "statutCode": { "type": "integer" },
            "data": { "type": "array", "items": { "$ref": "#/components/schemas/CompteAll" } },
            "message": { "type": "string" }
        },
        "required": ["statutCode","statut", "data", "message"]       
    },
   "CompteCreateRequest": {
       "type": "object",
       "properties": {
        "titulaire": { "type": "string" },
        "solde": { "type": "number" },
        "type": { 
            "type": "string",
            "enum": ["Epargne", "cheque"] 
        }  
     },
       "required": ["titulaire", "solde", "type"]
     }
   }
}
}
