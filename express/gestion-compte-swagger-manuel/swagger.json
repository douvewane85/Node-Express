{
   "openapi": "3.0.0",
    "info": {
    "title": "Gestion des comptes API",
    "version": "1.0.0",
    "description": "API simple pour gerer les comptes"
    },
    "servers": [
    {
        "url": "http://localhost:3002",
        "description": "Local server"
    }
    ],
"paths": {
    "/api/v1/comptes": {
        "get": {
        "summary": "Récupère la liste des comptes",
        "responses": {
            "200": {
            "description": "Liste des comptes récupérée avec succès",
            "content": {
                "application/json": {
                "schema": {
                    "$ref": "#/components/schemas/ResponseFormat"   
                }
            }
        }
        }
        }
     },
     "post":{
        "summary": "Créer un nouveau compte",
        "requestBody": {
            "required": true,
            "content": {
            "application/json": {
                "schema": {
                "$ref": "#/components/schemas/Compte"
                }
            }
            }
        },
        "responses": {
            "201": {
            "description": "Compte créé avec succès",
            "content": {
                "application/json": {
                "schema": {
                    "$ref": "#/components/schemas/ResponseFormat"
                }
                }
            }
            }
        }
     }

    },
    "/api/v1/comptes/{numero}/solde": {
        "get": {
        "summary": "Récupère le solde d'un compte par son numéro",
        "parameters": [
            {
            "name": "numero",
            "in": "path",
            "description": "Numéro du compte",
            "required": true,
            "schema": { "type": "string" }
            }
        ],
        "responses": {
            "200": {
            "description": "Solde du compte récupéré avec succès",
            "content": {
                "application/json": {
                "schema": {
                    "$ref": "#/components/schemas/ResponseFormat"
                }
                }
            }
            }
        }
        }
    } 
    
},
"components": {
    "schemas": {
        "Compte": {
        "type": "object",
        "properties": {
            "numero": { "type": "string" },
            "solde": { "type": "number" },
            "client": { "type": "string" }
        },
        "required": ["numero", "solde", "client"]
        },
        "ResponseFormat": {
        "type": "object",
        "properties": {
            "status": { "type": "integer" },
            "data": { "type": "array", "items": { "$ref": "#/components/schemas/Compte" } },
            "message": { "type": "string" }
        },
        "required": ["status", "data", "message"]       
    }
}
}
}